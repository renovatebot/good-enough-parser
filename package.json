{
  "name": "@renovatebot/good-enough-parser",
  "version": "1.2.0",
  "description": "Parse and query computer programs source code",
  "license": "MIT",
  "author": "Sergei Zharinov",
  "contributors": [
    "Jason Kuhrt"
  ],
  "repository": "https://github.com/renovatebot/good-enough-parser.git",
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "scripts": {
    "lint": "run-s lint:*",
    "lint:types": "tsc --noEmit",
    "lint:oxlint": "oxlint",
    "lint:oxfmt": "oxfmt --check",
    "fix": "run-s fix:*",
    "fix:oxlint": "oxlint --fix",
    "fix:oxfmt": "oxfmt",
    "dev": "run-p dev:*",
    "dev:coverage": "http-server ./coverage/lcov-report",
    "build": "run-s clean build:*",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:esm": "tsc --project tsconfig.esm.json",
    "test": "run-s lint test:*",
    "test:unit": "jest",
    "clean": "rm -rf dist node_modules/.cache coverage",
    "prepare": "husky",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@thi.ng/zipper": "1.0.3",
    "@types/moo": "0.5.10",
    "klona": "2.0.6",
    "moo": "0.5.3"
  },
  "devDependencies": {
    "@containerbase/oxlint-plugin": "1.0.3",
    "@containerbase/semantic-release-pnpm": "1.4.3",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "http-server": "14.1.1",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-junit": "17.0.0",
    "jest-watch-select-projects": "2.0.0",
    "jest-watch-suspend": "1.1.3",
    "jest-watch-typeahead": "3.0.1",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "semantic-release": "25.0.9",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "upath": "3.0.8"
  },
  "engines": {
    "node": ">=24.10.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.28.7"
}
