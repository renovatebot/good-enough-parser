{
  "name": "@renovatebot/good-enough-parser",
  "version": "1.2.0",
  "description": "Parse and query computer programs source code",
  "license": "MIT",
  "author": "Sergei Zharinov",
  "contributors": [
    "Jason Kuhrt"
  ],
  "repository": "https://github.com/renovatebot/good-enough-parser.git",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "run-s lint:*",
    "lint:types": "tsc --noEmit",
    "lint:oxlint": "oxlint",
    "lint:oxfmt": "oxfmt --check",
    "fix": "run-s fix:*",
    "fix:oxlint": "oxlint --fix",
    "fix:oxfmt": "oxfmt",
    "dev": "run-p dev:*",
    "dev:coverage": "http-server ./coverage/lcov-report",
    "build": "run-s clean build:*",
    "build:lib": "tsc --project tsconfig.build.json",
    "test": "run-s lint test:*",
    "test:unit": "vitest run",
    "clean": "rm -rf dist node_modules/.cache coverage",
    "prepare": "husky",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@thi.ng/zipper": "2.1.181",
    "@types/moo": "0.5.10",
    "klona": "2.0.6",
    "moo": "0.5.3"
  },
  "devDependencies": {
    "@containerbase/oxlint-plugin": "1.0.3",
    "@containerbase/semantic-release-pnpm": "1.4.3",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "http-server": "14.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "upath": "3.0.8",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.10.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.28.7"
}
